# OpenAI key for optional live mode; leave blank for local corpus mode.
OPENAI_API_KEY=sk-placeholder
# Model used for planning.
MARKETMIND_PLANNING_MODEL=gpt-5-mini
# Model used for research.
MARKETMIND_RESEARCH_MODEL=gpt-5-mini
# Model used for synthesis.
MARKETMIND_SYNTHESIS_MODEL=gpt-5-mini
# Maximum research iterations.
MARKETMIND_MAX_ITERATIONS=20
# Maximum tool calls.
MARKETMIND_MAX_TOOL_CALLS=40
# Maximum QC repair rounds.
MARKETMIND_MAX_REPAIR_ROUNDS=2
# Maximum estimated run cost in USD.
MARKETMIND_BUDGET_USD=2
# External request timeout in seconds.
MARKETMIND_TIMEOUT_SECONDS=30
# Maximum bounded retries.
MARKETMIND_MAX_RETRIES=2
